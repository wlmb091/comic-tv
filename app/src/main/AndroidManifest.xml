<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Keeps a torrent transfer alive while an external player (VLC, MX, Just Player) reads it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <!-- External video players the TV tab can hand a stream to. -->
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="video/*" /></intent>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="com.brouken.player" />
        <package android:name="org.courville.nova" />
    </queries>
    <application android:name=".ComicTvApplication" android:label="@string/app_name" android:theme="@style/Theme.ComicTV"
        android:icon="@drawable/ic_launcher" android:banner="@drawable/brand_wordmark"
        android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="true">
        <provider android:name=".explorer.ExplorerFileProvider"
            android:authorities="${applicationId}.explorer" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/explorer_paths" />
        </provider>
        <provider android:name=".sources.ExtensionFileProvider"
            android:authorities="${applicationId}.extensions" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/extension_paths" />
        </provider>
        <provider android:name=".updates.AppUpdateFileProvider"
            android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
        <activity android:name=".explorer.ExplorerSplitInstallActivity" android:exported="false" />
        <service android:name=".tv.TvStreamService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
